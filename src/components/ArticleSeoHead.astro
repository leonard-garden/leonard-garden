---
import { Fragment } from 'astro/jsx-runtime';
import { alternateHreflangLinksHtml } from '../lib/hreflang-links';

interface Props {
	canonicalUrl: string;
	alternateLinks: Array<{ localeCode: string; href: string }>;
	xDefaultHref: string;
	title: string;
	description: string;
	fontStylesheetUrl: string;
}

const { canonicalUrl, alternateLinks, xDefaultHref, title, description, fontStylesheetUrl } = Astro.props;

const alternateLinksHeadHtml = alternateHreflangLinksHtml(alternateLinks, xDefaultHref);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonicalUrl} />
<Fragment set:html={alternateLinksHeadHtml} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontStylesheetUrl} />
